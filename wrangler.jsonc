{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-10",
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
