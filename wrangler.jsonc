{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seo-mcp",
  "main": "src/index.ts",
  "routes": [{ "pattern": "seo-mcp.aitsai.com", "custom_domain": true }],
  "compatibility_date": "2026-08-10",
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 3 * * 1"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "seo-mcp-db",
      "database_id": "88c4a581-adc2-41e4-a7c6-5e47d3a20435",
      "migrations_dir": "migrations",
    },
  ],
}
