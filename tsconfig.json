{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2022", "WebWorker"],
    "types": [
      "@cloudflare/workers-types",
      "node",
      "vitest/globals",
      "@cloudflare/vitest-pool-workers"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "bff",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.bff-integration.config.ts"
  ]
}
